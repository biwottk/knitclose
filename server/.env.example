# knitclose API configuration.
#
# Copy to server/.env for local overrides. The defaults in src/config.ts already match
# the docker-compose services, so LOCAL DEVELOPMENT NEEDS NONE OF THIS -- the file
# exists to document what deployment must set, and to show how little changes.

# ---------------------------------------------------------------------------
# Local development (these are the built-in defaults; shown for reference)
# ---------------------------------------------------------------------------
# DATABASE_URL=postgres://knitclose:knitclose_dev_only@localhost:5434/knitclose
# STORAGE_ENDPOINT=http://localhost:9002
# STORAGE_ACCESS_KEY=knitclose
# STORAGE_SECRET_KEY=knitclose_dev_only
# STORAGE_BUCKET=knitclose-media
# AUTH_SECRET=dev-only-insecure-signing-key
# PORT=4001

# In development this now DEFAULTS to the detected LAN address, so a physical phone
# works with no configuration. Presigned URLs are signed against a hostname, and
# 'localhost' on a phone means the phone itself -- so every image would 403 while curl
# on the laptop worked fine.
#
# Override only when the detected interface is wrong (a VPN, a docker bridge) or when
# the phone reaches this machine by some other name (a tunnel).
# STORAGE_PUBLIC_URL=http://192.168.1.20:9002

# ---------------------------------------------------------------------------
# AWS (RDS + S3). Note what is NOT here: no code changes, no new dependencies.
# ---------------------------------------------------------------------------
# NODE_ENV=production
#
# RDS Postgres -- same driver, same SQL.
# DATABASE_URL=postgres://knitclose:<password>@knitclose.abc123.eu-west-2.rds.amazonaws.com:5432/knitclose
# DATABASE_SSL=true
#
# S3: DELETE STORAGE_ENDPOINT entirely. Its absence is what switches the SDK from
# MinIO's path-style addressing to S3 virtual-host addressing, and it is also what
# makes the app sign against the real S3 hostname.
# STORAGE_BUCKET=knitclose-media-prod
# STORAGE_REGION=eu-west-2
#
# Also OMIT STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY. With no static credentials the
# SDK uses the task or instance IAM role, which is strictly better than long-lived
# keys sitting in an environment variable.
#
# AUTH_SECRET must be a real secret (Secrets Manager / SSM), not a literal here.
# AUTH_SECRET=<32+ random bytes>
