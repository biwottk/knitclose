{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".npm-cache",
    // The API is a separate Node program with its own tsconfig (different module
    // resolution, no JSX, node types). Compiling it under the Expo config reports
    // errors that are not real.
    "server"
  ]
}
