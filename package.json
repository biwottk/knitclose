{
  "name": "knitclose",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint:icons": "node scripts/check-emoji.mjs",
    "shots": "node scripts/refresh-shots.mjs",
    "assets": "node scripts/extract-logo.cjs",
    "//": "--- backend ---",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:psql": "docker exec -it knitclose-db psql -U knitclose -d knitclose",
    "api": "npm --prefix server start",
    "api:install": "npm --prefix server install",
    "api:seed": "npm --prefix server run seed",
    "api:reseed": "npm --prefix server run seed -- --reset",
    "backend": "npm run db:up && npm run api:seed && npm run api",
    "lint:fixtures": "node scripts/check-fixtures.mjs",
    "check": "npm run typecheck && npm run lint:icons && npm run lint:fixtures"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@types/react": "~19.2.4",
    "buffer": "^6.0.3",
    "expo": "^57.0.22",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.46.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.14.0",
    "react-native-web": "^0.21.2",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "puppeteer-core": "^25.11.0"
  }
}
