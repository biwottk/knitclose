{
  "expo": {
    "name": "Close Knit",
    "slug": "knitclose",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "knitclose",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FCF9F6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.knitclose.app"
    },
    "android": {
      "package": "com.knitclose.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FCF9F6"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "May we look at your photos to add them to your Great Deed?",
          "cameraPermission": "May we use your camera to add a photo to your Great Deed?"
        }
      ],
      "expo-status-bar",
      "expo-font"
    ]
  }
}
